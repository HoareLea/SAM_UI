<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <Configurations>Debug;Release</Configurations>
    <OutputPath>..\..\build\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Part F grid row types and the rule that decides which of their columns are editable are
         implementation detail of this assembly, but the rule has to be testable: a two-way binding onto
         a read-only property throws only when WPF realises the cell, i.e. when the tab is first shown. -->
    <InternalsVisibleTo Include="SAM.Analytical.UI.WPF.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Controls\Filter\**" />
    <EmbeddedResource Remove="Controls\Filter\**" />
    <None Remove="Controls\Filter\**" />
    <Page Remove="Controls\Filter\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="gbXMLSerializer">
      <HintPath>..\..\references\gbXMLSerializer.dll</HintPath>
    </Reference>
    <Reference Include="Interop.TAS3D">
      <HintPath>..\..\references_buildonly\Interop.TAS3D.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.TBD">
      <HintPath>..\..\references_buildonly\Interop.TBD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.TCD">
      <HintPath>..\..\references_buildonly\Interop.TCD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.TIC">
      <HintPath>..\..\references_buildonly\Interop.TIC.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.TSD">
      <HintPath>..\..\references_buildonly\Interop.TSD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.gbXML">
      <HintPath>..\..\..\SAM_gbXML\build\SAM.Analytical.gbXML.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.GEM">
      <HintPath>..\..\..\SAM_GEM\build\SAM.Analytical.GEM.dll</HintPath>
    </Reference>
    <!-- The manufacturer ventilation-unit catalogue reader, for Approved Document O Iteration 2 equipment
         selection. Referenced HERE rather than from SAM.Analytical.UI on purpose: reading an installed
         resource is application orchestration, and SAM.Analytical.UI stays free of the SAM_Systems
         dependency. The selection RULE is not here - it is SAM.Analytical's, inside
         Modify.PreparePartOIteration. See Classes\PartO\VentilationUnitCatalogue.cs. -->
    <Reference Include="SAM.Analytical.Systems">
      <HintPath>..\..\..\SAM_Systems\build\SAM.Analytical.Systems.dll</HintPath>
    </Reference>
    <!-- PR1's materialised SystemEnergyCentre is the input the Approved Document O Iteration 3 explicit
         ventilation route converts, and its type lives here. Referenced for that one graph and nothing
         else - no system is authored, selected or modified in this assembly. -->
    <Reference Include="SAM.Core.Systems">
      <HintPath>..\..\..\SAM_Systems\build\SAM.Core.Systems.dll</HintPath>
    </Reference>
    <!-- SAM_Tas' TAS Systems route and its replaceable ResultantTemperature provider - Approved Document O
         Iteration 3's Candidate B. Its whole public surface here (SystemVentilationRoute,
         ResultantTemperatureResults, IResultantTemperatureProvider) is free of TAS COM types, exactly as
         SAM.Analytical.Tas.TM59's is, so no interop assembly is loaded by referencing it. -->
    <Reference Include="SAM.Analytical.Tas.TPD">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.TPD.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.LadybugTools">
      <HintPath>..\..\..\SAM_LadybugTools\build\SAM.Analytical.LadybugTools.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.SolarCalculator">
      <HintPath>..\..\..\SAM_SolarCalculator\build\SAM.Analytical.SolarCalculator.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Solver">
      <HintPath>..\..\..\SAM_Solver\build\SAM.Analytical.Solver.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas.SAP">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.SAP.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas.TM59">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.TM59.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.gbXML">
      <HintPath>..\..\..\SAM_gbXML\build\SAM.Core.gbXML.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.SolarCalculator">
      <HintPath>..\..\..\SAM_SolarCalculator\build\SAM.Core.SolarCalculator.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Tas">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Core.Tas.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Tas.UKBR">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Core.Tas.UKBR.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Windows">
      <HintPath>..\..\..\SAM_Windows\build\SAM.Core.Windows.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry.SolarCalculator">
      <HintPath>..\..\..\SAM_SolarCalculator\build\SAM.Geometry.SolarCalculator.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry.Solver">
      <HintPath>..\..\..\SAM_Solver\build\SAM.Geometry.Solver.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
    <!-- The SAM Documentation Framework (Space Assumptions PDF). SAM_UI only orchestrates: the data, units,
         document and layout all come from these assemblies. SAM.Units is referenced for the UnitStyle the
         reporting options take. -->
    <Reference Include="SAM.Analytical.Reporting">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.Reporting.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Reporting">
      <HintPath>..\..\..\SAM\build\SAM.Core.Reporting.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Reporting.Pdf">
      <HintPath>..\..\..\SAM\build\SAM.Core.Reporting.Pdf.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Units">
      <HintPath>..\..\..\SAM\build\SAM.Units.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather.Tas">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Weather.Tas.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf">
      <Version>2.27.0</Version>
    </PackageReference>
    <PackageReference Include="HoneybeeSchema">
      <Version>$(HoneybeeSchemaVersion)</Version>
    </PackageReference>
    <PackageReference Include="NetOfficeFw.Excel">
      <Version>1.9.7</Version>
    </PackageReference>
    <PackageReference Include="NetTopologySuite">
      <Version>2.6.0</Version>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- SAM.Core.Reporting.Pdf is a netstandard2.0 library in SAM\build, and a library build does not copy its
         NuGet dependencies there. This reference puts PDFsharp, MigraDoc and their Microsoft dependencies into
         build\ (and so into the installed %APPDATA%\SAM). Keep it at the version SAM.Core.Reporting.Pdf is built
         against: 6.2.0, the PDFsharp that SAM_Revit also uses. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Licences that must accompany the renderer: Noto Sans (SIL OFL 1.1, embedded in SAM.Core.Reporting.Pdf.dll;
         taken from SAM so there is one copy of the text) and PDFsharp/MigraDoc (MIT). -->
    <None Include="..\..\..\SAM\SAM\SAM.Core.Reporting.Pdf\Fonts\OFL.txt" Link="licenses\NotoSans\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\files\licenses\PDFsharp-MigraDoc\LICENSE.txt" Link="licenses\PDFsharp-MigraDoc\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\WPF\SAM.Core.Mollier.UI.WPF\SAM.Core.Mollier.UI.WPF.csproj" />
    <ProjectReference Include="..\..\SAM_UI\SAM.Analytical.UI\SAM.Analytical.UI.csproj" />
    <ProjectReference Include="..\..\SAM_UI\SAM.Core.UI\SAM.Core.UI.csproj" />
    <ProjectReference Include="..\..\SAM_UI\SAM.Geometry.UI\SAM.Geometry.UI.csproj" />
    <ProjectReference Include="..\SAM.Core.UI.WPF\SAM.Core.UI.WPF.csproj" />
    <ProjectReference Include="..\SAM.Geometry.UI.WPF\SAM.Geometry.UI.WPF.csproj" />
  </ItemGroup>
</Project>