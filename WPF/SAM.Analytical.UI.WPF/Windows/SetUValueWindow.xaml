<Window x:Class="SAM.Analytical.UI.WPF.SetUValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Set U-value" Height="720" Width="620" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Roboto Light">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Style_TableHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Muted}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,16,2"/>
            </Style>

            <Style x:Key="Style_TableValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- PATTERN B, ONE PROGRESSIVE WINDOW (U-value plan): the construction and the target on top, the live preview
         below, the apply scope inline, Advanced collapsed, Apply at the bottom. No Next/Back. Every value shown is
         read from UValueViewModel; after Apply the scoped check and the report appear in place. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CONSTRUCTION -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Construction" Style="{StaticResource PartO.SectionHeading}"/>
            <ComboBox x:Name="comboBox_Construction" DisplayMemberPath="Display" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      SelectionChanged="comboBox_Construction_SelectionChanged"/>
            <TextBlock x:Name="textBlock_ConstructionFacts" Style="{StaticResource PartO.Caption}" Margin="0,3,0,0"/>
            <TextBlock x:Name="textBlock_SelectionNote" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- TARGET -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Target U-value" Style="{StaticResource PartO.SectionHeading}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="textBox_Target" Width="110" Height="26" FontSize="14" VerticalContentAlignment="Center" TextChanged="textBox_Target_TextChanged"
                         ToolTip="The U-value to reach, in W/m²K. The preview updates as you type."/>
                <TextBlock Text="W/m²K" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <TextBlock x:Name="textBlock_Range" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="textBlock_Layer" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
        </StackPanel>

        <!-- PREVIEW: the status (glyph and words, never colour alone), Actual | Target | Margin | Status, the layers. -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock x:Name="textBlock_StatusGlyph" Style="{StaticResource PartO.StatusGlyph}" FontSize="14" VerticalAlignment="Top"/>
                    <TextBlock x:Name="textBlock_Status" TextWrapping="Wrap" MaxWidth="540" Foreground="{StaticResource PartO.Brush.Text}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Actual U" Style="{StaticResource Style_TableHeader}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Target U" Style="{StaticResource Style_TableHeader}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Margin" Style="{StaticResource Style_TableHeader}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Status" Style="{StaticResource Style_TableHeader}"/>
                    <TextBlock x:Name="textBlock_Actual" Grid.Row="1" Grid.Column="0" Style="{StaticResource Style_TableValue}"/>
                    <TextBlock x:Name="textBlock_TargetValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource Style_TableValue}"/>
                    <TextBlock x:Name="textBlock_Margin" Grid.Row="1" Grid.Column="2" Style="{StaticResource Style_TableValue}"/>
                    <TextBlock x:Name="textBlock_RowStatus" Grid.Row="1" Grid.Column="3" Style="{StaticResource Style_TableValue}"/>
                </Grid>

                <DataGrid x:Name="dataGrid_Layers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource PartO.Brush.Border}" MinHeight="90">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Adjusted}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="{StaticResource PartO.Brush.AccentSurface}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Before (mm)" Binding="{Binding ThicknessBefore, StringFormat={}{0:0.#}}" Width="90"/>
                        <DataGridTextColumn Header="After (mm)" Binding="{Binding ThicknessAfter, StringFormat={}{0:0.#}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="textBlock_Timing" Grid.Row="3" Style="{StaticResource PartO.Caption}" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- THE APPLY SCOPE, inline and in the main area (not under Advanced), before Apply: which panels (all N using the
             construction, or only the M selected), which construction, and the warnings. The labels carry the counts and are
             set from UValueViewModel.Scope. -->
        <Border Grid.Row="3" Margin="0,10,0,0" Background="{StaticResource PartO.Brush.AccentSurface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Changes" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource PartO.Brush.Muted}"/>
                    <RadioButton x:Name="radioButton_AllPanels" GroupName="Scope" IsChecked="True" Content="All panels using it" Margin="0,0,16,0" Checked="radioButton_Scope_Checked"/>
                    <RadioButton x:Name="radioButton_SelectedPanels" GroupName="Scope" Content="Only the selected" Checked="radioButton_Scope_Checked"/>
                </StackPanel>
                <TextBlock x:Name="textBlock_ScopeReason" Style="{StaticResource PartO.Caption}" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBlock x:Name="textBlock_Scope" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                <TextBlock x:Name="textBlock_Result" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}" Margin="0,2,0,0"/>
                <ItemsControl x:Name="itemsControl_Warnings" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="&#x26A0;" Style="{StaticResource PartO.StatusGlyph}" Foreground="{StaticResource PartO.Brush.Warning}"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="520" Foreground="{StaticResource PartO.Brush.Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="textBlock_Block" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Danger}" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ADVANCED: every automatic choice can be overridden here, and only here. -->
        <Expander x:Name="expander_Advanced" Grid.Row="4" Header="Advanced" Margin="0,8,0,0" IsExpanded="False">
            <Grid Margin="18,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Layer to vary" VerticalAlignment="Center" Margin="0,2,12,2" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <ComboBox x:Name="comboBox_Layer" Grid.Row="0" Grid.Column="1" Margin="0,2" DisplayMemberPath="Display" SelectionChanged="comboBox_Layer_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thickness range" VerticalAlignment="Center" Margin="0,2,12,2" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                    <TextBox x:Name="textBox_MinThickness" Width="60" TextChanged="textBox_Thickness_TextChanged"/>
                    <TextBlock Text=" – " VerticalAlignment="Center"/>
                    <TextBox x:Name="textBox_MaxThickness" Width="60" TextChanged="textBox_Thickness_TextChanged"/>
                    <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource PartO.Brush.Muted}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Heat flow" VerticalAlignment="Center" Margin="0,2,12,2" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <ComboBox x:Name="comboBox_HeatFlow" Grid.Row="2" Grid.Column="1" Margin="0,2" DisplayMemberPath="Display" SelectionChanged="comboBox_HeatFlow_SelectionChanged"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Name" VerticalAlignment="Top" Margin="0,4,12,2" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                    <CheckBox x:Name="checkBox_KeepName" Content="Keep name" Checked="checkBox_Options_Changed" Unchecked="checkBox_Options_Changed"
                              ToolTip="Change the construction itself and keep its name, so every panel using it changes. Otherwise a new construction is created and the source stays unchanged."/>
                    <TextBlock x:Name="textBlock_KeepNameReason" Style="{StaticResource PartO.Caption}" Margin="18,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Assign" VerticalAlignment="Top" Margin="0,4,12,2" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                    <CheckBox x:Name="checkBox_DontAssign" Content="Don't assign to any panel" Checked="checkBox_Options_Changed" Unchecked="checkBox_Options_Changed"
                              ToolTip="Create the new construction without assigning it to any panel."/>
                    <TextBlock x:Name="textBlock_DontAssignReason" Style="{StaticResource PartO.Caption}" Margin="18,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- AFTER APPLY: the scoped check (one line, the log one click away) and the report. -->
        <Border x:Name="border_Applied" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="4,1,1,1" CornerRadius="3" Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="textBlock_Applied" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="textBlock_CheckGlyph" Style="{StaticResource PartO.StatusGlyph}"/>
                        <TextBlock x:Name="textBlock_Check" TextWrapping="Wrap" MaxWidth="440" Foreground="{StaticResource PartO.Brush.Text}"/>
                    </StackPanel>
                    <Button x:Name="button_Details" Grid.Column="1" Content="Details" Width="70" Height="24" Click="button_Details_Click"
                            ToolTip="Open the check's records in the log window."/>
                </Grid>
                <TextBlock x:Name="textBlock_Report" Style="{StaticResource PartO.Caption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Button x:Name="button_CopyAll" HorizontalAlignment="Left" Width="80" Height="28" Visibility="Collapsed" Click="button_CopyAll_Click"
                    ToolTip="Copy the U-VALUE CHANGE report.">Copy All</Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="button_Apply" Style="{StaticResource PartO.PrimaryButton}" IsDefault="True" Width="90" Height="28" IsEnabled="False" Click="button_Apply_Click"
                        ToolTip="Apply the previewed change. One Apply is one Undo step.">Apply</Button>
                <Button x:Name="button_Cancel" IsCancel="True" Width="80" Height="28" Margin="8,0,0,0" Click="button_Cancel_Click">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
