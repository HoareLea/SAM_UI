<Window x:Class="SAM.Analytical.UI.WPF.PartORemoveResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part O — Remove Results" Width="760" Height="560" MinWidth="520" MinHeight="360"
        ResizeMode="CanResizeWithGrip" FontFamily="Roboto Light" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="PartO.RemoveResults.Line">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="textBlock_Heading" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"
                       Text="The open model is not changed, and no TAS or result files are deleted from disk. The cleaned copy is saved as a new file, which you can then open for Mixed Design. Geometry, zones, constructions, Part F requirements, weather and authored systems are kept."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PartO.SectionHeading}" Text="Removed from the copy"/>
                <ItemsControl x:Name="itemsControl_Removed" ItemTemplate="{StaticResource PartO.RemoveResults.Line}" Margin="8,0,0,0"/>
                <TextBlock x:Name="textBlock_NothingRemoved" Style="{StaticResource PartO.Caption}" Margin="8,0,0,0"
                           Text="Nothing: the model carries no Part O results or preparation."/>

                <StackPanel x:Name="stackPanel_Kept" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource PartO.SectionHeading}" Text="Left in the copy"/>
                    <ItemsControl x:Name="itemsControl_Kept" ItemTemplate="{StaticResource PartO.RemoveResults.Line}" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Style="{StaticResource PartO.SectionHeading}" Text="Mixed Design baseline check" Margin="0,10,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock x:Name="textBlock_CheckGlyph" Style="{StaticResource PartO.StatusGlyph}" VerticalAlignment="Top"/>
                    <TextBlock x:Name="textBlock_Check" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl x:Name="itemsControl_Findings" ItemTemplate="{StaticResource PartO.RemoveResults.Line}" Margin="26,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="textBlock_Saved" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="button_Save" Content="Save cleaned copy..." Height="26" Style="{StaticResource PartO.PrimaryButton}" IsDefault="True"/>
            <Button x:Name="button_Open" Content="Open cleaned copy" Height="26" Padding="12,0" Margin="8,0,0,0"/>
            <Button x:Name="button_Close" Content="Cancel" Width="80" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
