<Window x:Class="SAM.Analytical.UI.WPF.SpaceReportPdfBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Space reports" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- SAM Documentation Framework PR2F-2: many Spaces x one or both Space report PDFs into one folder, through
         SpaceReportPdfBatch (one model snapshot, one PDF at a time, one log). The Spaces are counted, never listed:
         a model can hold thousands. The one-Space commands (Space Assumptions PDF, Space Design Load Summary PDF)
         stay the quick route for a single Space. -->
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="groupBox_Reports" Grid.Row="0" Header="Reports" Padding="6,4,6,4">
            <StackPanel>
                <CheckBox x:Name="checkBox_SpaceAssumptions" Content="Space Assumptions" Margin="0,2,0,2" Checked="Options_Changed" Unchecked="Options_Changed"/>
                <CheckBox x:Name="checkBox_SpaceDesignLoadSummary" Content="Space Design Load Summary" Margin="0,2,0,2" Checked="Options_Changed" Unchecked="Options_Changed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="groupBox_Spaces" Grid.Row="1" Header="Spaces" Padding="6,4,6,4" Margin="0,8,0,0">
            <StackPanel>
                <RadioButton x:Name="radioButton_Selected" GroupName="Scope" Margin="0,2,0,2" Checked="Options_Changed" ToolTipService.ShowOnDisabled="True"/>
                <RadioButton x:Name="radioButton_All" GroupName="Scope" Margin="0,2,0,2" Checked="Options_Changed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="groupBox_Folder" Grid.Row="2" Header="Output folder" Padding="6,4,6,4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="textBox_Folder" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" Height="24"
                         AutomationProperties.Name="Output folder"/>
                <Button x:Name="button_Browse" Grid.Column="1" Content="Browse..." MinWidth="80" Height="24" Margin="6,0,0,0" Click="button_Browse_Click"/>
            </Grid>
        </GroupBox>

        <StackPanel x:Name="stackPanel_Progress" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="textBlock_Progress" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock x:Name="textBlock_ProgressDetail" TextWrapping="Wrap" Foreground="#555555" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="progressBar" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1" AutomationProperties.Name="Progress"/>
        </StackPanel>

        <StackPanel x:Name="stackPanel_Summary" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="textBlock_Summary" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="button_OpenFolder" Content="Open folder" MinWidth="90" Height="24" Padding="8,0" Click="button_OpenFolder_Click"/>
                <Button x:Name="button_OpenLog" Content="Open log" MinWidth="90" Height="24" Padding="8,0" Margin="6,0,0,0" Click="button_OpenLog_Click"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="textBlock_Hint" Grid.Column="0" TextWrapping="Wrap" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="button_Export" Grid.Column="1" Content="Export" MinWidth="80" Height="24" IsDefault="True" Click="button_Export_Click"/>
            <Button x:Name="button_Cancel" Grid.Column="2" Content="Cancel" MinWidth="80" Height="24" Margin="6,0,0,0" Click="button_Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
