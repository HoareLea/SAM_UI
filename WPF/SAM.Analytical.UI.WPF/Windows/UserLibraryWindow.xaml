<Window x:Class="SAM.Analytical.UI.WPF.UserLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My library" Height="560" Width="900" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Roboto Light"
        AutomationProperties.AutomationId="window_UserLibrary" AutomationProperties.Name="My library">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <Style x:Key="Style_Warning" TargetType="TextBlock" BasedOn="{StaticResource PartO.Caption}">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Warning}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="Style_Danger" TargetType="TextBlock" BasedOn="{StaticResource PartO.Caption}">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Danger}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- The result of the last Rename / Remove: a caption, or an error (red) when it says why nothing changed. -->
            <Style x:Key="Style_Result" TargetType="TextBlock" BasedOn="{StaticResource PartO.Caption}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Style_Command" TargetType="Button">
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- MY LIBRARY. Two tabs: the saved glazing systems of "My glazing systems" (rename, remove to the archive, open in the Glazing System Builder) and the
         saved opaque constructions of "My constructions" (rename, remove to the archive, details; there is no opaque edit - a construction is authored in the
         Constructions editor and saved as a new one). No analytical model is behind this window: nothing here can change a model or add an Undo step. -->
    <TabControl x:Name="tabControl_Library" Margin="8" AutomationProperties.AutomationId="tabControl_Library">

        <!-- GLAZING SYSTEMS (the window's DataContext: UserLibraryViewModel) -->
        <TabItem x:Name="tabItem_Glazing" Header="Glazing systems" AutomationProperties.AutomationId="tabItem_Glazing">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Glazing systems" Style="{StaticResource PartO.SectionHeading}" AutomationProperties.AutomationId="textBlock_Section"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_Count"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Note}" Style="{StaticResource Style_Warning}" Margin="0,6,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="textBlock_Note"/>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" MinWidth="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ListView x:Name="listView_Systems" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Single"
                                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.AutomationId="listView_Systems" AutomationProperties.Name="Saved glazing systems"
                                  PreviewKeyDown="listView_Systems_PreviewKeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="AutomationProperties.AutomationId" Value="listViewItem_System"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SavedText}" Style="{StaticResource PartO.Caption}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding PaneBuildUp}" Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ValuesText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FrameText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="320"
                                   Visibility="{Binding ShowEmptyText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="textBlock_Empty"/>
                    </Grid>

                    <!-- DETAILS: how the selected system is made and how it was built -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Details" Style="{StaticResource PartO.SectionHeading}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Focusable="False">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" AutomationProperties.AutomationId="textBlock_Details" AutomationProperties.Name="Details of the selected system"/>
                                <TextBlock Text="{Binding DetailsPlaceholderText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Visibility="{Binding ShowDetailsPlaceholder, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="textBlock_DetailsPlaceholder"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- RENAME: inline, with the library's own naming rule shown as you type -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="stackPanel_Rename">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="New name" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button x:Name="button_RenameCancel" Content="Cancel" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="6,0,0,0" Click="button_RenameCancel_Click"
                                AutomationProperties.AutomationId="button_RenameCancel"/>
                        <Button x:Name="button_RenameOk" Content="Rename" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="6,0,0,0" IsEnabled="{Binding CanCommitRename}" Click="button_RenameOk_Click"
                                AutomationProperties.AutomationId="button_RenameOk" ToolTip="Changes only the name. The system keeps its Guid, layers, materials and history."/>
                        <TextBox x:Name="textBox_Rename" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="textBox_Rename_PreviewKeyDown"
                                 AutomationProperties.AutomationId="textBox_Rename" AutomationProperties.Name="New name"/>
                    </DockPanel>
                    <TextBlock Text="{Binding RenameError}" Style="{StaticResource Style_Danger}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_RenameError"/>
                </StackPanel>

                <!-- COMMANDS -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Style_Result}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.AutomationId="textBlock_Message"/>
                    <TextBlock Text="{Binding ArchiveText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="textBlock_Archive"/>
                    <DockPanel LastChildFill="False">
                        <Button x:Name="button_Close" Content="Close" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="0" IsCancel="True" Click="button_Close_Click" AutomationProperties.AutomationId="button_Close"/>
                        <Button x:Name="button_Rename" Content="Rename…" DockPanel.Dock="Left" Style="{StaticResource Style_Command}" IsEnabled="{Binding CanRename}" Click="button_Rename_Click"
                                AutomationProperties.AutomationId="button_Rename" ToolTip="Give the selected system another name. Nothing else about it changes."/>
                        <Button x:Name="button_Remove" Content="Remove…" DockPanel.Dock="Left" Style="{StaticResource Style_Command}" IsEnabled="{Binding CanRemove}" Click="button_Remove_Click"
                                AutomationProperties.AutomationId="button_Remove" ToolTip="Take the selected system out of My glazing systems. It is moved to the archive, not deleted, and models that use it keep their copy."/>
                        <Button x:Name="button_OpenInBuilder" Content="Open in Builder…" DockPanel.Dock="Left" Style="{StaticResource Style_Command}" IsEnabled="{Binding CanOpenInBuilder}" Click="button_OpenInBuilder_Click"
                                AutomationProperties.AutomationId="button_OpenInBuilder" ToolTip="Edit the selected system in the Glazing System Builder. Save as new keeps it as it is; Save and replace saves the result as a new system and moves the selected one to the archive."/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- CONSTRUCTIONS (DataContext: UserConstructionLibraryViewModel, set by the window) -->
        <TabItem x:Name="tabItem_Constructions" Header="Constructions" AutomationProperties.AutomationId="tabItem_Constructions">
            <Grid x:Name="grid_Constructions" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Constructions" Style="{StaticResource PartO.SectionHeading}" AutomationProperties.AutomationId="textBlock_ConstructionsSection"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_ConstructionsCount"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Note}" Style="{StaticResource Style_Warning}" Margin="0,6,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="textBlock_ConstructionsNote"/>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" MinWidth="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ListView x:Name="listView_Constructions" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Single"
                                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.AutomationId="listView_Constructions" AutomationProperties.Name="Saved constructions"
                                  PreviewKeyDown="listView_Constructions_PreviewKeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="AutomationProperties.AutomationId" Value="listViewItem_Construction"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SavedText}" Style="{StaticResource PartO.Caption}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding BuildUp}" Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding UValueText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding HeatFlowBasisText}" Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="320"
                                   Visibility="{Binding ShowEmptyText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="textBlock_ConstructionsEmpty"/>
                    </Grid>

                    <!-- DETAILS: how the selected construction is made and where it was saved from -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Details" Style="{StaticResource PartO.SectionHeading}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Focusable="False">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" AutomationProperties.AutomationId="textBlock_ConstructionDetails" AutomationProperties.Name="Details of the selected construction"/>
                                <TextBlock Text="{Binding DetailsPlaceholderText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Visibility="{Binding ShowDetailsPlaceholder, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="textBlock_ConstructionDetailsPlaceholder"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- RENAME: inline, with the library's own naming rule shown as you type -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="stackPanel_ConstructionRename">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="New name" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button x:Name="button_ConstructionRenameCancel" Content="Cancel" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="6,0,0,0" Click="button_ConstructionRenameCancel_Click"
                                AutomationProperties.AutomationId="button_ConstructionRenameCancel"/>
                        <Button x:Name="button_ConstructionRenameOk" Content="Rename" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="6,0,0,0" IsEnabled="{Binding CanCommitRename}" Click="button_ConstructionRenameOk_Click"
                                AutomationProperties.AutomationId="button_ConstructionRenameOk" ToolTip="Changes only the name. The construction keeps its Guid, layers, materials and history."/>
                        <TextBox x:Name="textBox_ConstructionRename" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="textBox_ConstructionRename_PreviewKeyDown"
                                 AutomationProperties.AutomationId="textBox_ConstructionRename" AutomationProperties.Name="New name"/>
                    </DockPanel>
                    <TextBlock Text="{Binding RenameError}" Style="{StaticResource Style_Danger}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_ConstructionRenameError"/>
                </StackPanel>

                <!-- COMMANDS: no edit - a construction is authored in the Constructions editor and saved as a new one -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Style_Result}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.AutomationId="textBlock_ConstructionsMessage"/>
                    <TextBlock Text="{Binding ArchiveText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="textBlock_ConstructionsArchive"/>
                    <DockPanel LastChildFill="False">
                        <Button x:Name="button_ConstructionsClose" Content="Close" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" Margin="0" Click="button_Close_Click" AutomationProperties.AutomationId="button_ConstructionsClose"/>
                        <Button x:Name="button_ConstructionRename" Content="Rename…" DockPanel.Dock="Left" Style="{StaticResource Style_Command}" IsEnabled="{Binding CanRename}" Click="button_ConstructionRename_Click"
                                AutomationProperties.AutomationId="button_ConstructionRename" ToolTip="Give the selected construction another name. Nothing else about it changes."/>
                        <Button x:Name="button_ConstructionRemove" Content="Remove…" DockPanel.Dock="Left" Style="{StaticResource Style_Command}" IsEnabled="{Binding CanRemove}" Click="button_ConstructionRemove_Click"
                                AutomationProperties.AutomationId="button_ConstructionRemove" ToolTip="Take the selected construction out of My constructions. It is moved to the archive, not deleted, and models that use it keep their copy."/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
