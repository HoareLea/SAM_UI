<Window x:Class="SAM.Analytical.UI.WPF.PartOMixedDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        xmlns:WPF="clr-namespace:SAM.Core.UI.WPF;assembly=SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Part O — Mixed Design" Width="1240" Height="780" MinWidth="900" MinHeight="560"
        ResizeMode="CanResizeWithGrip" FontFamily="Roboto Light" WindowStartupLocation="CenterOwner"
        x:Name="window">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- An outcome cell: the WORD is always there (PASS / FAIL / NOT RUN / STALE ...); colour and weight only
                 reinforce it, so no state depends on colour alone. -->
            <Style x:Key="PartO.Mixed.OutcomeCell" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Muted}"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="PASS">
                        <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Success}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="Text" Value="FAIL">
                        <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Danger}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="Text" Value="STALE">
                        <Setter Property="FontStyle" Value="Italic"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PartO.Mixed.Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- LAYOUT, top to bottom: what the design IS (the readiness and final-result summary), the project rules and
         the simulation case (collapsed - they rarely change), the matrix of dwellings with its search, filter and
         bulk bar, and the actions, which sit outside every scroll region and are always reachable. -->
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WHAT: one strategy per dwelling, built into one mixed model. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Mixed dwelling strategies" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"
                       Text="Select a strategy for each dwelling, then build ONE mixed model from the clean baseline and run it. Screening is optional evidence: it never changes your selection unless you apply its suggestions. The final mixed run is the design authority."/>
            <TextBlock x:Name="textBlock_Baseline" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="textBlock_Outcome" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.AccentDark}"/>
        </StackPanel>

        <!-- SUMMARY: the selected design, the final mixed result, and the screening - three separate lines, because they
             are three separate authorities. -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,6" Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected design" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="textBlock_Readiness" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Final result" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="textBlock_Final" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Screening" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="textBlock_Screening" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource PartO.Brush.Muted}"/>
            </Grid>
        </Border>

        <!-- PROJECT RULES - stated once for the whole project, not per dwelling. -->
        <Expander Grid.Row="2" x:Name="expander_Constraints" Margin="0,8,0,0">
            <Expander.Header>
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="Project constraints and products"/>
                    <Run x:Name="run_ConstraintsSummary" Foreground="#666666"/>
                </TextBlock>
            </Expander.Header>
            <StackPanel Margin="18,6,0,0">
                <CheckBox x:Name="checkBox_NaturalAllowed" Content="Natural ventilation is allowed (untick: every dwelling must be mechanically ventilated)"/>
                <CheckBox x:Name="checkBox_OptimisationAllowed" Content="An optimised (retained) design airflow is allowed" Margin="0,4,0,0"/>
                <CheckBox x:Name="checkBox_Cooling" Content="Active cooling is allowed for MVHR dwellings" Margin="0,4,0,0"
                          ToolTip="A project rule only. Whether a dwelling can be cooled is SAM's answer at Check design / Build: its selected product's manufacturer cooling guidance, the published cooling airflow range and the unit's capacity."/>
                <TextBlock Style="{StaticResource PartO.Caption}" Margin="20,0,0,0" Text="A cooled dwelling uses its selected product's manufacturer cooling guidance, so products must be selected from the catalogue. Any cooled dwelling runs the whole building on the TAS Systems route."/>
                <CheckBox x:Name="checkBox_CatalogueOffered" Content="Select MVHR products from the ventilation unit catalogue" Margin="0,8,0,0"/>
                <TextBlock x:Name="textBlock_ProductPool" Style="{StaticResource PartO.Caption}" Margin="20,0,0,0"/>
            </StackPanel>
        </Expander>

        <StackPanel Grid.Row="3">
        <!-- SYSTEMS IN THIS ASSESSMENT: SAM's answer, displayed - which ventilation systems the selected design assesses,
             which stay on the design without being assessed, or why it is refused. Nothing here decides, edits or removes. The
             lists are virtualised and bounded, so a model with hundreds of systems is two scroll regions, never a control per system. -->
        <Expander x:Name="expander_Systems" Margin="0,8,0,0">
            <Expander.Header>
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="Systems in this assessment" FontWeight="SemiBold"/>
                    <Run x:Name="run_SystemsSummary" Foreground="#666666"/>
                </TextBlock>
            </Expander.Header>
            <StackPanel Margin="18,6,0,0">
                <TextBlock x:Name="textBlock_SystemsRefusal" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Danger}" Visibility="Collapsed" Margin="0,0,0,6"/>
                <Grid x:Name="grid_Systems">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="textBlock_SystemsIncludedHeader" FontWeight="SemiBold"/>
                        <TextBlock x:Name="textBlock_SystemsIncludedNone" Text="None" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                        <ListBox x:Name="listBox_SystemsIncluded" MaxHeight="112" Margin="0,2,0,0" BorderThickness="1" BorderBrush="{StaticResource PartO.Brush.Border}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 AutomationProperties.Name="Systems included in this assessment"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="textBlock_SystemsRetainedHeader" FontWeight="SemiBold"/>
                        <TextBlock x:Name="textBlock_SystemsRetainedNone" Text="None" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                        <ListBox x:Name="listBox_SystemsRetained" MaxHeight="112" Margin="0,2,0,0" BorderThickness="1" BorderBrush="{StaticResource PartO.Brush.Border}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 AutomationProperties.Name="Systems retained on the design and not assessed"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="textBlock_SystemsNote" Style="{StaticResource PartO.Caption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Expander>

        <!-- SIMULATION CASE: the three inputs of the full-year TAS run a person owns, as in Prepare & Run. -->
        <Expander x:Name="expander_SimulationCase" Margin="0,4,0,0">
            <Expander.Header>
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="Simulation case"/>
                    <Run x:Name="run_SimulationCaseSummary" Foreground="#666666"/>
                </TextBlock>
            </Expander.Header>
            <Grid Margin="18,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Weather" VerticalAlignment="Center"/>
                <WPF:SelectSAMObjectComboBoxControl x:Name="selectSAMObjectComboBoxControl_Weather" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="22"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Output folder" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <TextBox x:Name="textBox_OutputDirectory" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,6,6,0" VerticalContentAlignment="Center" ToolTip="The Part O output root. SAM writes this design's runs into its MixedDesign folder inside it, with tas, reports and diagnostics folders."/>
                <Button x:Name="button_OutputDirectory" Grid.Row="1" Grid.Column="2" Content="…" Width="30" Height="22" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Solar calculation" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <ComboBox x:Name="comboBox_SolarCalculationMethod" Grid.Row="2" Grid.Column="1" Width="160" Height="22" Margin="0,6,0,0" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0" Style="{StaticResource PartO.Caption}"
                           Text="The rest of the case is fixed for Part O: a full-year simulation over days 1 to 365, no sizing, no exports. Each run writes its own results (the mixed run as &lt;model&gt;_Mixed, each screening strategy as &lt;model&gt;_Screen_&lt;strategy&gt;), so none overwrites another."/>
            </Grid>
        </Expander>
        </StackPanel>

        <!-- THE MATRIX: one row per dwelling. Search, filter and group narrow it; nothing below the grid scrolls with it. -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="textBox_Search" Width="200" Height="22" VerticalContentAlignment="Center"/>
                <TextBlock Text="Show" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="comboBox_Filter" Width="230" Height="22"/>
                <CheckBox x:Name="checkBox_Group" Content="Group by zone category" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button x:Name="button_SelectShown" Content="Select all shown" Height="22" Padding="8,0" Margin="14,0,0,0"/>
                <TextBlock x:Name="textBlock_Shown" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource PartO.Caption}"/>
            </StackPanel>

            <!-- SAM's structured refusals from the last check or build that name no single dwelling. -->
            <TextBlock Grid.Row="1" x:Name="textBlock_Refusals" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Danger}" Visibility="Collapsed"/>

            <!-- Virtualised: rows and columns are realised only while visible, including while grouped, and recycled as the
                 grid scrolls - five thousand spaces are a few hundred plain-text rows here, never five thousand controls. -->
            <DataGrid Grid.Row="2" x:Name="dataGrid_Dwellings" Margin="0,6,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True" RowHeight="24">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,6,0,2" FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" · " Foreground="#666666"/>
                                    <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="#666666"/>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dwelling" Binding="{Binding Name, Mode=OneWay}" Width="125" ElementStyle="{StaticResource PartO.Mixed.Cell}"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Group, Mode=OneWay}" Width="90" ElementStyle="{StaticResource PartO.Mixed.Cell}"/>
                    <DataGridTextColumn Header="Spaces" Binding="{Binding SpaceCount, Mode=OneWay}" Width="52" ElementStyle="{StaticResource PartO.Mixed.Cell}"/>

                    <!-- SCREENING: evidence only, read-only, one column per engineering strategy. -->
                    <DataGridTextColumn x:Name="column_Natural" Header="Screening&#x0a;Natural" Binding="{Binding Screening_Natural, Mode=OneWay}" Width="78" ElementStyle="{StaticResource PartO.Mixed.OutcomeCell}"/>
                    <DataGridTextColumn x:Name="column_MechanicalBaseline" Header="Screening&#x0a;MVHR baseline" Binding="{Binding Screening_MechanicalBaseline, Mode=OneWay}" Width="92" ElementStyle="{StaticResource PartO.Mixed.OutcomeCell}"/>
                    <DataGridTextColumn x:Name="column_SelectedProduct" Header="Screening&#x0a;Product MVHR" Binding="{Binding Screening_SelectedProduct, Mode=OneWay}" Width="92" ElementStyle="{StaticResource PartO.Mixed.OutcomeCell}"/>
                    <DataGridTextColumn x:Name="column_Optimised" Header="Screening&#x0a;Optimised" Binding="{Binding Screening_Optimised, Mode=OneWay}" Width="86" ElementStyle="{StaticResource PartO.Mixed.OutcomeCell}"/>
                    <DataGridTextColumn x:Name="column_ActiveCooling" Header="Screening&#x0a;Cooling" Binding="{Binding Screening_ActiveCooling, Mode=OneWay}" Width="86" ElementStyle="{StaticResource PartO.Mixed.OutcomeCell}"/>

                    <!-- SUGGESTED: derived, never authority. -->
                    <DataGridTemplateColumn Header="Suggested" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SuggestionText, Mode=OneWay}" ToolTip="{Binding SuggestionReason, Mode=OneWay}" Style="{StaticResource PartO.Mixed.Cell}" Foreground="{StaticResource PartO.Brush.Muted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SELECTED: the designer's authority - the only strategy that is built. -->
                    <DataGridTextColumn Header="Selected (your design)" Binding="{Binding SelectedText, Mode=OneWay}" Width="163">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PartO.Mixed.Cell}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ACTIVE COOLING: orthogonal to the strategy, a word per row (On / Off / — where there is no MVHR supply). -->
                    <DataGridTextColumn x:Name="column_Cooling" Header="Active&#x0a;cooling" Binding="{Binding CoolingText, Mode=OneWay}" Width="62" ElementStyle="{StaticResource PartO.Mixed.Cell}"/>
                    <DataGridTextColumn Header="Cooling control&#x0a;room" Binding="{Binding CoolingControlRoomText, Mode=OneWay}" Width="125" ElementStyle="{StaticResource PartO.Mixed.Cell}"/>

                    <!-- FINAL: the last mixed run, shown as current only while it is current. -->
                    <DataGridTemplateColumn Header="Final TM59" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FinalText, Mode=OneWay}" ToolTip="{Binding FinalDetail, Mode=OneWay}" Style="{StaticResource PartO.Mixed.OutcomeCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Failing spaces / note" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PartO.Mixed.Cell}" ToolTip="{Binding FinalDetail, Mode=OneWay}">
                                    <Run Text="{Binding FailingSpacesText, Mode=OneWay}"/>
                                    <Run Text="{Binding FinalRanAs, Mode=OneWay}" Foreground="#666666"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Needs attention" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Attention, Mode=OneWay}" ToolTip="{Binding Attention, Mode=OneWay}" Style="{StaticResource PartO.Mixed.Cell}" Foreground="{StaticResource PartO.Brush.Danger}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- BULK: every edit acts on the selected rows - one dwelling or a hundred - so nothing is edited a row at a time. -->
        <Border Grid.Row="5" Margin="0,8,0,0" Padding="8,6" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock x:Name="textBlock_SelectionCount" VerticalAlignment="Center" FontWeight="SemiBold" Width="170"/>
                    <Button x:Name="button_SetNatural" Content="Natural ventilation" Height="24" Padding="8,0" ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="button_SetMvhr" Content="MVHR" Height="24" Padding="8,0" Margin="8,0,0,0"/>
                    <ComboBox x:Name="comboBox_Product" Width="260" Height="24" Margin="4,0,0,0" ToolTip="The product for 'MVHR': automatic selection from the project's pool, or one permitted product for every selected dwelling."/>
                    <Button x:Name="button_SetRetained" Content="Retain baseline design airflow" Height="24" Padding="8,0" Margin="8,0,0,0"
                            ToolTip="Optimised MVHR: keep the design airflow the baseline's ventilation terminals already carry for these MVHR dwellings. Only SAM's design fingerprint is recorded; no airflow is copied."/>
                    <Button x:Name="button_AcceptOptimised" Content="Accept optimised airflow…" Height="24" Padding="8,0" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Optimised MVHR from a completed Iteration 2B result: choose the 2B result model, see every design airflow it changes for the ONE selected dwelling, and confirm. SAM writes it onto that dwelling's design terminals on the baseline; no other dwelling changes and nothing is simulated."/>
                    <Button x:Name="button_CoolingOn" Content="Cooling on" Height="24" Padding="8,0" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="button_CoolingOff" Content="Cooling off" Height="24" Padding="8,0" Margin="4,0,0,0"
                            ToolTip="Active cooling off for the selected dwellings. Their ventilation strategy is unchanged; the next Build &amp; Run rebuilds the whole design from the clean baseline."/>
                    <ComboBox x:Name="comboBox_CoolingControlRoom" Width="180" Height="24" Margin="8,0,0,0" DisplayMemberPath="Value" ToolTip="Choose a room in the one selected cooled dwelling."/>
                    <Button x:Name="button_SetCoolingControlRoom" Content="Confirm control room" Height="24" Padding="8,0" Margin="4,0,0,0"/>
                    <Button x:Name="button_Clear" Content="Clear" Height="24" Padding="8,0" Margin="8,0,0,0"/>
                    <Button x:Name="button_ApplySuggestions" Content="Apply suggestions…" Height="24" Padding="8,0" Margin="16,0,0,0"
                            ToolTip="Shows what applying the screening suggestions would change for the selected dwellings (or all shown dwellings), and changes nothing until you confirm."/>
                </WrapPanel>
                <TextBlock x:Name="textBlock_BulkMessage" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Danger}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6" x:Name="textBlock_Next" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <!-- ACTIONS: screening is optional and secondary; building the selected design is the one primary action. -->
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="button_Screen" Content="Screen strategies…" Height="28" Padding="10,0" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Runs selected Part O strategies to determine which dwellings pass. Screening does not change your selected final design until you apply or edit the suggestions."/>
            <Button Grid.Column="1" x:Name="button_Check" Content="Check design" Height="28" Padding="10,0" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Asks SAM to materialise the selected design from the baseline - no simulation - and lists every refusal against its dwelling."/>
            <Button Grid.Column="2" x:Name="button_ReviewFinal" Content="Open final TM59 result…" Height="28" Padding="10,0" Margin="8,0,0,0" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True"/>
            <Button Grid.Column="3" x:Name="button_Save" Content="Save selection" Height="28" Padding="10,0" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Writes the selected strategies onto the model. Save the model to keep them."/>
            <Button Grid.Column="4" x:Name="button_Build" Content="Build &amp; Run Mixed Design" Height="28" Margin="8,0,0,0" Style="{StaticResource PartO.PrimaryButton}" ToolTipService.ShowOnDisabled="True"/>
            <Button Grid.Column="5" x:Name="button_Close" Content="Close" Height="28" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
