<Window x:Class="SAM.Analytical.UI.WPF.PartOPreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Part O — Review iteration" Height="760" Width="1260" MinWidth="640" MinHeight="420"
        FontFamily="Roboto Light">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- An absent figure shown as an absence rather than as "NaN". Display only; see the converter. -->
            <local:PartOAirFlowConverter x:Key="Converter_AirFlow"/>

            <!-- A product's identity in engineer-facing words - "test (project test)" and never the literal
                 join "Project test test". Display only; see Query.PartOProductLabel. -->
            <local:PartOProductLabelConverter x:Key="Converter_ProductLabel"/>

            <!-- NUMBERS RIGHT, TEXT LEFT, so a column of airflows can be scanned by magnitude. -->
            <Style x:Key="Style_Numeric" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <Style x:Key="Style_Numeric_PartF" TargetType="TextBlock" BasedOn="{StaticResource Style_Numeric}">
                <Setter Property="ToolTip" Value="{Binding PartFRequiredDescription}"/>
            </Style>

            <Style x:Key="Style_Numeric_Design" TargetType="TextBlock" BasedOn="{StaticResource Style_Numeric}">
                <Setter Property="ToolTip" Value="Airflow designed by this iteration and passed to the simulation. It is independent of which product is selected."/>
            </Style>

            <Style x:Key="Style_Numeric_Max" TargetType="TextBlock" BasedOn="{StaticResource Style_Numeric}">
                <Setter Property="ToolTip" Value="The selected product's capability ceiling. It does not replace the design airflow."/>
            </Style>

            <Style x:Key="Style_Numeric_Headroom" TargetType="TextBlock" BasedOn="{StaticResource Style_Numeric}">
                <Setter Property="ToolTip" Value="Product maximum minus design airflow. Positive headroom means the selected unit can meet the design duty."/>
            </Style>

            <!-- THE THREE PAIRED CONCEPTS - Design, Equipment maximum, Headroom - separated by a rule at the
                 first column of each group rather than by a two-tier header. A grouped header cannot be built
                 out of the DataGrid this window already uses without a custom column-header component, and a
                 new table component is far more than a presentation pass should cost. Consistent names, a
                 fixed order and a visible separator do the same job here. -->
            <Style x:Key="Style_GroupCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="BorderBrush" Value="#C8C8C8"/>
            </Style>

            <Style x:Key="Style_GroupHeader" TargetType="controls:DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="BorderThickness" Value="1,0,1,1"/>
                <Setter Property="BorderBrush" Value="#999999"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
            </Style>

            <Style x:Key="Style_NumericHeader" TargetType="controls:DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
            </Style>

            <!-- The engineering tables keep every column; only their chrome follows the Part O palette. -->
            <Style x:Key="Style_Table" TargetType="DataGrid">
                <Setter Property="BorderBrush" Value="{StaticResource PartO.Brush.Border}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#EAEEF2"/>
                <Setter Property="VerticalGridLinesBrush" Value="#EAEEF2"/>
                <Setter Property="Background" Value="White"/>
            </Style>

            <!-- A label in the run summary. -->
            <Style x:Key="Style_FactLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Muted}"/>
                <Setter Property="Margin" Value="0,1,12,1"/>
            </Style>

            <Style x:Key="Style_FactValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Text}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,1,0,1"/>
                <!-- Transparent, not absent, so the whole line is hit-testable and its tooltip appears. -->
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- LAYOUT, top to bottom, in the order an engineer reads a prepared run: WHAT is about to be simulated
         (the scenario and its run summary), the DWELLING assignments, the SPACE airflows, then the
         diagnostics - counted and one switch away - and the decision, which is always the bottom row. The two
         engineering tables keep every column they had; nothing on them is simplified away. -->
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="rowDefinition_Equipment" Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WHAT: the scenario, named exactly as the Hub names it, and the run in five short lines. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="textBlock_Scenario" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PartO.Brush.Text}" TextWrapping="Wrap"/>
            <!-- Worded by Intent - see PartOPreparationWindow.Intent. -->
            <TextBlock x:Name="textBlock_Subtitle" Style="{StaticResource PartO.Caption}" FontSize="12" Margin="0,2,0,8"/>

            <Border Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Thermal model" Style="{StaticResource Style_FactLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="textBlock_Scope" Style="{StaticResource Style_FactValue}"/>
                    <!-- Shown, not tooltipped: an isolated run is a different thermal model. -->
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="textBlock_ScopeDetail" Style="{StaticResource PartO.Caption}" Margin="0,0,0,3" Visibility="Collapsed"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Route" Style="{StaticResource Style_FactLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="textBlock_Route" Style="{StaticResource Style_FactValue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Design duty" Style="{StaticResource Style_FactLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="textBlock_Duty" Style="{StaticResource Style_FactValue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Equipment" Style="{StaticResource Style_FactLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="textBlock_Equipment" Style="{StaticResource Style_FactValue}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Overheating" Style="{StaticResource Style_FactLabel}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="textBlock_OverheatingScenarios" Style="{StaticResource Style_FactValue}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- CONVERT TO MANUAL sits with the assignments rather than in the previous dialog, because this is
             the first point at which the automatic answer exists to be converted. It is a change of
             SELECTION AUTHORITY and not a recalculation: every dwelling keeps the exact product it has.

             The authority controls are drawn only where equipment selection is in play (Iteration 2). On
             Iteration 1a and 1b they could never apply, and greyed controls invite a person to work out why. -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Dwelling assignments" Style="{StaticResource PartO.SectionHeading}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Design duty and equipment capacity are different quantities" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="stackPanel_Authority" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="textBlock_Mode" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource PartO.Brush.Muted}"/>
                <Button x:Name="button_ConvertToManual" Content="Convert to Manual" Width="130" Height="24" Click="button_ConvertToManual_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Switches to Manual per dwelling while retaining the current assignments as the starting point."/>
            </StackPanel>
        </Grid>

        <!-- EXTENDED selection, so click / Ctrl+click / Shift+click / Ctrl+A behave the way every other
             table in Windows does. A project of a thousand flats cannot be assigned one row at a time, and
             the bulk action below is what a selection is FOR - editing one row's picker still changes that
             row alone, deliberately, because "editing a cell edits every highlighted row" is far too easy
             to trigger by accident and far too hard to notice afterwards.

             Recycling, because the point of all this is large tables. -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="dataGrid_Equipment" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" MinHeight="90" SelectionMode="Extended" SelectionUnit="FullRow" Style="{StaticResource Style_Table}"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="dataGrid_Equipment_SelectionChanged" CellEditEnding="dataGrid_Equipment_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dwelling" Binding="{Binding Dwelling}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="80" IsReadOnly="True"/>

                    <!-- DESIGN. Design duty and equipment maximum are deliberately in separate, differently
                         headed and visibly separated columns. A dwelling designed at 30 l/s that is fitted with
                         a 150 l/s unit is a 30 l/s dwelling. -->
                    <DataGridTextColumn Header="Design SUP (l/s)" Binding="{Binding DesignSupplyDuty_Lps, Converter={StaticResource Converter_AirFlow}}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Design}" CellStyle="{StaticResource Style_GroupCell}" HeaderStyle="{StaticResource Style_GroupHeader}"/>
                    <DataGridTextColumn Header="Design EXT (l/s)" Binding="{Binding DesignExtractDuty_Lps, Converter={StaticResource Converter_AirFlow}}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Design}" HeaderStyle="{StaticResource Style_NumericHeader}"/>

                    <!-- The one editable cell, and only in manual mode - the grid itself is read-only in the
                         automatic modes, where these rows are results rather than choices. The picker's list is
                         the project's permitted pool plus this dwelling's own product where that has since left
                         the pool, so a procurement change can never make an authored assignment unpickable. -->
                    <!-- THE ONE FLEXIBLE COLUMN. Every other column is sized for its own header, and the
                         Status column has to be visible without scrolling - it is the one that says whether a
                         dwelling's product will do. So the spare width goes here, where a longer product name
                         can use it, and MinWidth keeps the picker usable when the window is made narrow.

                         Fixed columns total 955px; the default 1260px window leaves this about 250px. See
                         PartOConsistencyPolishTests.TheAssignmentRow_FitsTheDefaultWindowWidth, which fails if
                         a column is widened past that again - which is how the unit-in-header headings pushed
                         Status off the right edge of the old 1140px default. -->
                    <DataGridTemplateColumn Header="Assigned product" Width="*" MinWidth="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedProduct}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!-- An ItemTemplate over Query.PartOProductLabel, so the picker reads the
                                     engineer-facing label - identity and both maximum airflows - and never the
                                     descriptor's ToString, which is the diagnostic form and ends with the
                                     catalogue's internal rank. Rank is a tie-breaker, not an airflow, an
                                     efficiency or a rating, and a picker that prints it invites it to be read
                                     as one. The template rather than DisplayMemberPath because the project test
                                     product's identity needs spelling out - see the converter. -->
                                <ComboBox ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Converter_ProductLabel}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- EQUIPMENT MAXIMUM. A capability ceiling, never a design airflow and never a target. -->
                    <DataGridTextColumn Header="Max SUP (l/s)" Binding="{Binding MaximumSupply_Lps, Converter={StaticResource Converter_AirFlow}}" Width="95" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Max}" CellStyle="{StaticResource Style_GroupCell}" HeaderStyle="{StaticResource Style_GroupHeader}"/>
                    <DataGridTextColumn Header="Max EXT (l/s)" Binding="{Binding MaximumExtract_Lps, Converter={StaticResource Converter_AirFlow}}" Width="95" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Max}" HeaderStyle="{StaticResource Style_NumericHeader}"/>

                    <!-- HEADROOM. The equipment maximum less the design airflow, and nothing else. -->
                    <DataGridTextColumn Header="SUP headroom (l/s)" Binding="{Binding SupplyHeadroom_Lps, Converter={StaticResource Converter_AirFlow}}" Width="110" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Headroom}" CellStyle="{StaticResource Style_GroupCell}" HeaderStyle="{StaticResource Style_GroupHeader}"/>
                    <DataGridTextColumn Header="EXT headroom (l/s)" Binding="{Binding ExtractHeadroom_Lps, Converter={StaticResource Converter_AirFlow}}" Width="110" IsReadOnly="True"
                                        ElementStyle="{StaticResource Style_Numeric_Headroom}" HeaderStyle="{StaticResource Style_NumericHeader}"/>

                    <DataGridTextColumn Header="Status" Binding="{Binding SelectionOutcome}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Iteration 1b builds no mechanical system, so it has no dwelling unit to list. Said in words
                 instead of drawing an empty table with ten headings. -->
            <TextBlock x:Name="textBlock_NoEquipment" Style="{StaticResource PartO.Caption}" FontSize="12" Visibility="Collapsed" Margin="0,0,0,4"
                       Text="No dwelling units: this route builds no mechanical ventilation system, so there is no design duty or equipment to assign."/>
        </Grid>

        <!-- The selected row in words, and the ONLY way a suggestion is ever applied. A suggestion is
             offered here and taken by clicking; nothing is substituted because a suggestion exists. -->
        <Grid x:Name="grid_Assignment" Grid.Row="3" Margin="0,4,0,0">
            <TextBlock x:Name="textBlock_Assignment" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Muted}" Margin="0,0,150,0"/>
            <Button x:Name="button_AssignSuggested" Content="Assign suggested" Width="130" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsEnabled="False" Click="button_AssignSuggested_Click" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Populates the suggested smallest-capable assignment as a starting point for manual review - this dwelling only. Manual mode remains authoritative, and no airflow changes."/>
        </Grid>

        <!-- BULK ASSIGNMENT. Offered only under manual authority, and an EXPLICIT act: the product is
             chosen here and applied by clicking, to the rows that are selected and to no others. Every
             dwelling is then validated against its OWN design duty - one product applied to twelve flats
             can be sufficient for eleven and reported insufficient for the twelfth, and it is neither
             replaced there nor is that flat's design airflow reduced to fit it.

             The product list is the project's permitted set, and deliberately NOT the union of every
             selected dwelling's candidates: an out-of-pool product belongs to the one dwelling that has
             it, and offering twelve flats' historical outsiders as a project-wide choice would offer
             products the project does not permit.

             Nothing is written here. Like every other edit in this window it is staged until the review is accepted. -->
        <Grid x:Name="grid_Bulk" Grid.Row="4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="textBlock_BulkSelection" VerticalAlignment="Center" Foreground="{StaticResource PartO.Brush.Muted}" MinWidth="170"/>
                <ComboBox x:Name="comboBox_BulkProduct" Width="300" Height="24" Margin="6,0,0,0"
                          SelectionChanged="comboBox_BulkProduct_SelectionChanged"
                          ToolTip="The product to assign to every selected dwelling. The project's permitted products; each dwelling is still checked against its own design duty.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource Converter_ProductLabel}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="button_ApplyToSelected" Content="Apply to selected" Width="130" Height="24" Margin="6,0,0,0"
                        IsEnabled="False" Click="button_ApplyToSelected_Click" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Assigns the chosen product to the selected dwellings. Design airflows are unchanged, and nothing is written until you accept the review."/>
                <!-- What the last bulk assignment actually did, inline and beside the button that did it.
                     Presentation feedback only: it is cleared by the next selection or authority change and
                     nothing reads it. -->
                <TextBlock x:Name="textBlock_BulkConfirmation" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource PartO.Brush.Success}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,4">
            <TextBlock Text="Spaces" Style="{StaticResource PartO.SectionHeading}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="textBlock_SpacesCaption" Text="Approved Document F requirement and design airflow are different quantities" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center"/>
        </StackPanel>
        <DataGrid x:Name="dataGrid_Spaces" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="90"
                  Style="{StaticResource Style_Table}" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <!-- WHICH DWELLING a space belongs to, resolved from the model's own zone-space relations
                     and never from a space's name, prefix, index or row order. The dwelling name is
                     repeated on every row rather than merged or blanked: repeats read slightly worse and
                     filter, sort, copy and export far better, and this is a table engineers paste into a
                     spreadsheet. Presentation only - no membership, scope or airflow is changed. -->
                <DataGridTextColumn Header="Dwelling / Zone" Binding="{Binding Dwelling}" Width="130"/>
                <DataGridTextColumn Header="Space" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Part F required (l/s)" Binding="{Binding PartFRequired_Lps, Converter={StaticResource Converter_AirFlow}}" Width="120"
                                    ElementStyle="{StaticResource Style_Numeric_PartF}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                <DataGridTextColumn x:Name="column_Spaces_DesignSupply" Header="Design SUP (l/s)" Binding="{Binding DesignSupply_Lps, Converter={StaticResource Converter_AirFlow}}" Width="110"
                                    ElementStyle="{StaticResource Style_Numeric_Design}" CellStyle="{StaticResource Style_GroupCell}" HeaderStyle="{StaticResource Style_GroupHeader}"/>
                <DataGridTextColumn x:Name="column_Spaces_DesignExtract" Header="Design EXT (l/s)" Binding="{Binding DesignExtract_Lps, Converter={StaticResource Converter_AirFlow}}" Width="110"
                                    ElementStyle="{StaticResource Style_Numeric_Design}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- THE DIAGNOSTICS, counted and COLLAPSED: "Warnings (8) · Notes (38)" and a Show details switch -
             the same switch the Hub uses for its readiness detail. Nothing is dropped: the box below holds
             every line, Copy All always copies every line, and a preparation that REFUSED something opens
             with the box shown, because a refusal is not a note.

             The WARNINGS in the box are grouped: warning lines that are character-for-character identical are
             shown once with a "× N" after them. Refusals and notes are never collapsed. Nothing is parsed,
             categorised, re-graded or dropped, and "Show every line" puts the complete record back on
             screen. -->
        <Border Grid.Row="7" Margin="0,10,0,0" Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="8,4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Diagnostics" Style="{StaticResource PartO.SectionHeading}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="label_Diagnostics" VerticalAlignment="Center" Foreground="{StaticResource PartO.Brush.Text}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- HIDDEN, not greyed, where nothing was collapsed - which on today's Part O warnings is
                         every run: each one names its space, so no two are ever character-for-character
                         identical. A permanently disabled tick advertises a capability that never arrives and
                         invites the engineer to work out why they cannot use it. See SetDiagnostics. -->
                    <CheckBox x:Name="checkBox_ShowEveryLine" Content="Show every line" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                              Visibility="Collapsed" IsEnabled="False" Click="checkBox_ShowEveryLine_Click"
                              ToolTip="Identical warnings are shown once with a &quot;× N&quot; count; refusals and notes are never collapsed. Tick this to list every line separately. Copy All always copies every line."/>
                    <CheckBox x:Name="checkBox_ShowDiagnostics" Content="Show details" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                              Checked="checkBox_ShowDiagnostics_Changed" Unchecked="checkBox_ShowDiagnostics_Changed"
                              ToolTip="Show every note, warning and refusal the preparation produced. Copy All always copies all of them, shown or not."/>
                    <Button x:Name="button_CopyAll" Content="Copy All" Width="80" Height="22" Click="button_CopyAll_Click"
                            ToolTip="Copy the summary, both tables and every note, warning and refusal - ungrouped and complete."/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBox x:Name="textBox_Notes" Grid.Row="8" Height="160" Margin="0,4,0,0" Visibility="Collapsed"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>

        <!-- THE DECISION. The consequential action is named for what it does, and what it does depends on the
             command that opened this window: Prepare & Run goes on into TAS ("Accept & Run TAS"), the Prepare
             Iteration command only adopts the model ("Accept Preparation"). The wording, caption and tooltips
             are set from Intent in code. Cancel is the ordinary secondary button and Esc. Deliberately NOT
             IsDefault: Enter must never start a TAS run. -->
        <Grid Grid.Row="9" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="textBlock_Decision" Grid.Column="0" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="button_Accept" Height="28" MinWidth="150" Style="{StaticResource PartO.PrimaryButton}" Click="button_Accept_Click"/>
                <Button x:Name="button_Cancel" IsCancel="True" Width="80" Height="28" Margin="8,0,0,0" Click="button_Cancel_Click"
                        ToolTip="Close without adopting anything. The loaded model is unchanged and nothing is simulated.">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
