<Window x:Class="SAM.Analytical.UI.WPF.PartFAssessmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:geometry="clr-namespace:SAM.Geometry.UI.WPF;assembly=SAM.Geometry.UI.WPF"
        Title="Part F Conformance Assessment"
        Height="760" Width="1180" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Dwelling" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ComboBox_Dwelling" DockPanel.Dock="Left" Width="220" SelectionChanged="ComboBox_Dwelling_SelectionChanged"/>

            <TextBlock x:Name="TextBlock_Level" DockPanel.Dock="Left" Text="Level" VerticalAlignment="Center" Margin="16,0,6,0" Visibility="Collapsed"/>
            <ComboBox x:Name="ComboBox_Level" DockPanel.Dock="Left" Width="110" Visibility="Collapsed" SelectionChanged="ComboBox_Level_SelectionChanged"/>

            <TextBlock DockPanel.Dock="Left" Text="Operating mode" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="ComboBox_Mode" DockPanel.Dock="Left" Width="200" SelectionChanged="ComboBox_Mode_SelectionChanged"/>

            <TextBlock x:Name="TextBlock_Status" DockPanel.Dock="Left" Margin="24,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>

            <Button DockPanel.Dock="Right" x:Name="Button_Report" Content="Full report..." Width="110" Margin="6,0,0,0" Click="Button_Report_Click"/>
            <Button DockPanel.Dock="Right" x:Name="Button_CopyAll" Content="Copy All" Width="90" Click="Button_CopyAll_Click"/>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="TabControl_Main">
            <TabItem Header="Airflow overlay">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                        <Grid>
                            <!-- The shared SAM 2D floor plan. Real spaces, walls, doors and coordinates:
                                 the airflow is drawn over the building, not over a diagram of it. -->
                            <geometry:FloorPlan2DControl x:Name="FloorPlan"/>

                            <TextBlock x:Name="TextBlock_PlanMessage" Margin="16" TextWrapping="Wrap"
                                       VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="520"
                                       Foreground="#666666" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Show" FontWeight="Bold" Margin="0,0,0,4"/>
                            <CheckBox x:Name="CheckBox_Terminals" Content="Terminal tags" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_Transfer" Content="Transfer routes" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_DoorData" Content="Door data" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_Unresolved" Content="Unresolved routes" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_Values" Content="Values" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_Compliance" Content="Compliance status" IsChecked="True" Click="Overlay_Changed"/>
                            <CheckBox x:Name="CheckBox_Context" Content="Context geometry" IsChecked="True" Click="Overlay_Changed"/>
                            <Button x:Name="Button_Reset" Content="Reset view" Margin="0,8,0,8" Click="Button_Reset_Click"/>

                            <TextBlock Text="Legend" FontWeight="Bold" Margin="0,8,0,4"/>
                            <ItemsControl x:Name="ItemsControl_Legend"/>
                        </StackPanel>

                        <GroupBox DockPanel.Dock="Bottom" Header="Selection" Height="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TextBlock_Selection" TextWrapping="Wrap" Text="Select a room, a door or a transfer route." />
                            </ScrollViewer>
                        </GroupBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Terminals">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Required, proposed and provided are three separate columns. Required is what the Approved Document asks of the room. Proposed is what SAM generated to carry it, from the system type and the room. Provided is what the design actually records, and it is blank until somebody records it: a proposed terminal sizes the schedule but is never evidence that one is installed. Set a space's PartF Local Extract Method to record the real arrangement. Every value here is calculated and this grid is read-only."/>
                    <DataGrid x:Name="DataGrid_Terminals" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Internal doors">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Approved Document F paragraph 1.25: internal doors provide a minimum free area of 7,600 mm2, equivalent to a 10 mm undercut in a 760 mm wide door, achieved as 10 mm above a fitted floor finish or 20 mm above an unfinished floor surface. The requirement is an AREA: paragraph 1.25 prescribes no flow rate for an individual door, so the l/s columns headed &quot;calculated&quot; are SAM's airflow-network routing and no door passes or fails on them. The provided undercut, free area, transfer device and any flow override are engineering inputs: SAM cannot see the gap under a door leaf, and an unrecorded undercut is never treated as compliance."/>
                    <DataGrid x:Name="DataGrid_Doors" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Purge ventilation">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Approved Document F paragraphs 1.26 to 1.31 and Table 1.4: every habitable room needs purge ventilation capable of at least four air changes per hour directly to the outside. The opening type and angle and the openable area are engineering inputs, because Table 1.4 is about the area of the OPENING and a fixed light adds window area while opening nothing. The window area the model carries is shown as context only."/>
                    <DataGrid x:Name="DataGrid_Purge" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Checks">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Requirements no analytical model contains wait here for a person to confirm them. What SAM calculated and what the assessment reports are shown as two columns, and the calculated result is never overwritten. A confirmation resolves a check the model could not decide; against a check the calculation found FAILING it does not produce a pass, and the check goes to alternative solution pending approval where an alternative compliance method has been recorded and to engineering review otherwise. A calculated failure leaves the assessment by the input being corrected and the dwelling recalculated, by the missing evidence being supplied, or by an alternative method being accepted by a building control body. Entries are stored with the dwelling's commissioning record, so they survive a recalculation."/>
                    <DataGrid x:Name="DataGrid_Checks" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Schematic">
                <TextBox x:Name="TextBox_Schematic" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                       Text="A Part F conformance assessment, not a certificate. Compliance is demonstrated to a building control body, on the complete design and the built work, by a suitably qualified person."/>
            <Button DockPanel.Dock="Right" x:Name="Button_Cancel" Content="Cancel" Width="90" Margin="6,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="Button_OK" Content="Apply" Width="90" IsDefault="True" Click="Button_OK_Click"/>
        </DockPanel>
    </Grid>
</Window>
