<Window x:Class="SAM.Analytical.UI.WPF.UserConstructionNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save to My constructions" Width="460" SizeToContent="Height" MinWidth="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Roboto Light"
        AutomationProperties.AutomationId="window_UserConstructionName" AutomationProperties.Name="Save to My constructions">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Style_Command" TargetType="Button">
                <Setter Property="Padding" Value="14,2"/>
                <Setter Property="MinWidth" Value="72"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- SAVE TO MY CONSTRUCTIONS: asks for the name only. What is saved is a NEW construction of My constructions; no analytical model is behind
         this window, so nothing here can change a model or add an Undo step. -->
    <StackPanel Margin="14">
        <TextBlock x:Name="textBlock_Description" TextWrapping="Wrap" AutomationProperties.AutomationId="textBlock_Description"/>
        <TextBlock Text="It is saved to My constructions as a new construction; the model is not changed." Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <TextBlock Text="Name" Margin="0,0,0,2"/>
        <TextBox x:Name="textBox_Name" TextChanged="textBox_Name_TextChanged" AutomationProperties.AutomationId="textBox_Name" AutomationProperties.Name="Name of the construction"/>
        <TextBlock x:Name="textBlock_Problem" Style="{StaticResource PartO.Caption}" Foreground="{StaticResource PartO.Brush.Danger}" TextWrapping="Wrap" MinHeight="16" Margin="0,2,0,0"
                   AutomationProperties.AutomationId="textBlock_Problem"/>
        <DockPanel LastChildFill="False" Margin="0,10,0,0">
            <Button x:Name="button_Cancel" Content="Cancel" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" IsCancel="True" Click="button_Cancel_Click" AutomationProperties.AutomationId="button_Cancel"/>
            <Button x:Name="button_Save" Content="Save" DockPanel.Dock="Right" Style="{StaticResource Style_Command}" IsDefault="True" Click="button_Save_Click" AutomationProperties.AutomationId="button_Save"/>
        </DockPanel>
    </StackPanel>
</Window>
