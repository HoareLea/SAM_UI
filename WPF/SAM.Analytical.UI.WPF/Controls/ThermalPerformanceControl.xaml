<UserControl x:Class="SAM.Analytical.UI.WPF.ThermalPerformanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200" FontFamily="Roboto Light">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A row is a flat button: a click highlights its elements in the view. -->
            <Style x:Key="Style_Row" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{StaticResource PartO.Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PartO.Brush.Border}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PartO.Brush.AccentSurface}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PartO.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- THE THERMAL PERFORMANCE PANEL (Stage B, read-only): follows the selection, or lists the whole external envelope; the stored
         performance and the counts per construction; a click on a row highlights its elements in the view. It never edits. -->
    <Border Background="White" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1,0,0,0" Padding="10,8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Thermal performance" Style="{StaticResource PartO.SectionHeading}" FontSize="14"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="radioButton_Selection" GroupName="ThermalMode" Content="Selection" IsChecked="True" Margin="0,0,16,0" Checked="radioButton_Mode_Checked"/>
                <RadioButton x:Name="radioButton_WholeEnvelope" GroupName="ThermalMode" Content="Whole envelope" Checked="radioButton_Mode_Checked"/>
            </StackPanel>
            <TextBlock x:Name="textBlock_Summary" DockPanel.Dock="Top" Style="{StaticResource PartO.Caption}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsControl_Groups" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,2,0,4" Foreground="{StaticResource PartO.Brush.Text}"/>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Style_Row}" Click="button_Row_Click" Tag="{Binding}" AutomationProperties.Name="{Binding ConstructionName}"
                                                    ToolTip="Click to highlight these elements in the view.">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PartO.Caption}"/>
                                                    <TextBlock Text="{Binding ConstructionName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                                                    <TextBlock Text="{Binding PerformanceText}" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource PartO.Caption}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
