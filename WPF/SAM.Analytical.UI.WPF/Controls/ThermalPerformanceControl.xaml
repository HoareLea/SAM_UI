<UserControl x:Class="SAM.Analytical.UI.WPF.ThermalPerformanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260" FontFamily="Roboto Light">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- A row header is a flat button: a click highlights its elements in the view. -->
            <Style x:Key="Style_Row" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{StaticResource PartO.Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PartO.Brush.Border}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PartO.Brush.AccentSurface}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PartO.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style_Warning" TargetType="TextBlock" BasedOn="{StaticResource PartO.Caption}">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Warning}"/>
            </Style>

            <Style x:Key="Style_Danger" TargetType="TextBlock" BasedOn="{StaticResource PartO.Caption}">
                <Setter Property="Foreground" Value="{StaticResource PartO.Brush.Danger}"/>
            </Style>

            <Style x:Key="Style_Link" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="Style_LinkToggle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <!-- Shown for opaque rows only / for apertures only (the row's editor says which). -->
            <Style x:Key="Style_OpaqueOnly" TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAperture}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Style_ApertureOnly" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAperture}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- THE THERMAL PERFORMANCE PANEL: follows the selection, or lists the whole external envelope; the stored performance and the
         counts per construction; a click on a row header highlights its elements in the view (Stage B). Stage C: each row is also an
         editor - a target U (opaque) or Change... to a complete glazing system - with the scope inline, a live preview, and ONE
         Apply for every row edited, with the check before Apply, one Undo. The editing logic is the existing row view-models, in
         ThermalRowEditor / ThermalEditSession; this file only presents it. -->
    <Border x:Name="border_Host" Background="White" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1,0,0,0" Padding="10,8">
        <DockPanel>
            <!-- The host (docked column or floating window) is not the control's business: the button only asks for the other one. -->
            <Grid DockPanel.Dock="Top">
                <TextBlock Text="Thermal performance" Style="{StaticResource PartO.SectionHeading}" FontSize="14" VerticalAlignment="Center"/>
                <Button x:Name="button_Host" HorizontalAlignment="Right" Content="Undock" Padding="8,1" Click="button_Host_Click" AutomationProperties.AutomationId="button_ThermalHost"
                        ToolTip="Move the panel into its own window, for example onto a second monitor."/>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="radioButton_Selection" GroupName="ThermalMode" Content="Selection" IsChecked="True" Margin="0,0,16,0" Checked="radioButton_Mode_Checked"/>
                <RadioButton x:Name="radioButton_WholeEnvelope" GroupName="ThermalMode" Content="Whole envelope" Checked="radioButton_Mode_Checked"/>
            </StackPanel>
            <!-- The 3D view coloured by a stored thermal property (view state only: the model, its history and the saved view settings are not touched). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Colour by:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="comboBox_ColourBy" MinWidth="200" DisplayMemberPath="Label" SelectionChanged="comboBox_ColourBy_SelectionChanged"
                          AutomationProperties.AutomationId="comboBox_ColourBy" AutomationProperties.Name="Colour by" ToolTip="Colour the 3D view by a stored thermal property, with a legend. The model is not changed.">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
            <!-- SOURCES: where candidates come from beyond the model and the default library. Adding one only fills the pool; nothing reaches the model until Apply. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" AutomationProperties.AutomationId="stackPanel_Sources">
                <DockPanel>
                    <Button x:Name="button_MyLibrary" DockPanel.Dock="Right" Content="My library…" Padding="8,1" Margin="6,0,0,0" Click="button_MyLibrary_Click" AutomationProperties.AutomationId="button_MyLibrary"
                            ToolTip="Open My library: the glazing systems you saved with the Glazing System Builder. Rename or remove one, or open it in the Builder. Nothing is written to the model."/>
                    <Button x:Name="button_AddSource" DockPanel.Dock="Right" Content="Add source…" Padding="8,1" Click="button_AddSource_Click" AutomationProperties.AutomationId="button_AddSource"
                            ToolTip="Add a Tas construction database (.tcd) or a JSON file of constructions as a source of candidates for walls, roofs, floors and glazing. It is remembered. Nothing is written to the model until you apply a choice."/>
                    <TextBlock Text="Sources" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="textBlock_SourcesHint" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_SourcesHint"/>
                <ItemsControl x:Name="itemsControl_Sources" Focusable="False" AutomationProperties.AutomationId="itemsControl_Sources">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,0,0" ToolTip="{Binding ToolTip}">
                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Style_Link}" Click="button_ForgetSource_Click" Tag="{Binding}" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="button_ForgetSource" AutomationProperties.Name="{Binding Label, StringFormat=Forget {0}}"
                                        ToolTip="Forget this source: it is no longer offered or remembered. The file and the model are not touched."/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="textBlock_SourceLabel"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" AutomationProperties.AutomationId="textBlock_SourceStatus"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock x:Name="textBlock_Summary" DockPanel.Dock="Top" Style="{StaticResource PartO.Caption}" Margin="0,0,0,8"/>

            <!-- Apply bar: the check before Apply, the summary, Discard and Apply; afterwards the one-line result. -->
            <Border x:Name="border_Apply" DockPanel.Dock="Bottom" Visibility="Collapsed" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock x:Name="textBlock_Notice" Style="{StaticResource Style_Warning}" Margin="0,0,0,4" Visibility="Collapsed" AutomationProperties.AutomationId="textBlock_Notice"/>
                    <TextBlock x:Name="textBlock_Result" Style="{StaticResource PartO.Caption}" Foreground="{StaticResource PartO.Brush.Success}" Margin="0,0,0,4" Visibility="Collapsed" AutomationProperties.AutomationId="textBlock_Result"/>
                    <StackPanel x:Name="stackPanel_Pending" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="button_Details" DockPanel.Dock="Right" Content="Details" Style="{StaticResource Style_Link}" Click="button_Details_Click" Visibility="Collapsed" AutomationProperties.AutomationId="button_Details"/>
                            <TextBlock x:Name="textBlock_Check" Text="Before apply:" Style="{StaticResource PartO.Caption}" AutomationProperties.AutomationId="textBlock_Check"/>
                        </DockPanel>
                        <TextBlock x:Name="textBlock_Pinned" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_Pinned"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="button_Apply" DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PartO.PrimaryButton}" MinWidth="72" Height="26" Click="button_Apply_Click" AutomationProperties.AutomationId="button_Apply"/>
                            <Button x:Name="button_Discard" DockPanel.Dock="Right" Content="Discard" Margin="0,0,6,0" Padding="10,0" Height="26" Click="button_Discard_Click" AutomationProperties.AutomationId="button_Discard"/>
                            <TextBlock x:Name="textBlock_ChangeSummary" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}" AutomationProperties.AutomationId="textBlock_ChangeSummary"/>
                        </DockPanel>
                        <TextBlock Text="One Undo reverts it." Style="{StaticResource PartO.Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsControl_Groups" Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,2,0,4" Foreground="{StaticResource PartO.Brush.Text}"/>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <!-- The row header: type, construction, the stored performance, how many use it. A click highlights them. -->
                                                <Button Style="{StaticResource Style_Row}" Click="button_Row_Click" Tag="{Binding}" AutomationProperties.Name="{Binding ConstructionName}"
                                                        ToolTip="Click to highlight these elements in the view.">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource PartO.Caption}"/>
                                                        <TextBlock Text="{Binding ConstructionName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                                                        <TextBlock Text="{Binding PerformanceText}" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource PartO.Caption}"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- The row editor (the existing row view-model behind it). -->
                                                <Border Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3" Padding="8,4,8,6" Margin="0,-1,0,0">
                                                    <StackPanel DataContext="{Binding Editor}">
                                                        <!-- Where the stored value comes from, and Recalculate when it is missing, varying or out of date. -->
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Recalculate" Style="{StaticResource Style_Link}" Click="button_Recalculate_Click"
                                                                    Visibility="{Binding NeedsRecalculation, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="button_Recalculate"
                                                                    ToolTip="Refresh the thermal values stored on the model (one Undo)."/>
                                                            <TextBlock Text="{Binding ProvenanceText}" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <Button Content="Recalculate" HorizontalAlignment="Left" Style="{StaticResource Style_Link}" Click="button_Recalculate_Click" Margin="0,2,0,0"
                                                                Visibility="{Binding StoredIsOutOfDate, Converter={StaticResource BoolToVisibility}}" ToolTip="Refresh the thermal values stored on the model (one Undo)."/>

                                                        <!-- OPAQUE: target U, live preview -->
                                                        <StackPanel Style="{StaticResource Style_OpaqueOnly}" Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Target U" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBox Width="70" Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="textBox_Target"
                                                                         AutomationProperties.Name="{Binding Row.ConstructionName, StringFormat=Target U {0}}" ToolTip="Type the U-value you want, in W/m²K."/>
                                                                <TextBlock Text="W/m²K" Style="{StaticResource PartO.Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding PreviewGlyph}" Style="{StaticResource PartO.StatusGlyph}"/>
                                                                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" MaxWidth="260" AutomationProperties.AutomationId="textBlock_Preview"/>
                                                            </StackPanel>
                                                            <!-- ALTERNATIVES: the generated variant and the existing constructions that meet the target or come close. Nothing is chosen for the user. -->
                                                            <StackPanel Visibility="{Binding HasAlternatives, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" AutomationProperties.AutomationId="stackPanel_Alternatives">
                                                                <TextBlock Text="Alternatives" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding AlternativesCountText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" Margin="0,2,0,2" AutomationProperties.AutomationId="textBlock_AlternativesCount"/>
                                                                <ListBox ItemsSource="{Binding AlternativeRows}" SelectedItem="{Binding SelectedAlternative, Mode=TwoWay}" MaxHeight="230" HorizontalContentAlignment="Stretch"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="listBox_Alternatives">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel ToolTip="{Binding Tooltip}" Margin="0,2">
                                                                                <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding UText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding OriginText}" Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding WarningText}" Style="{StaticResource Style_Warning}" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </StackPanel>
                                                            <StackPanel Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding BlockReason}" Style="{StaticResource Style_Danger}" Margin="0,2,0,0"/>
                                                                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" Style="{StaticResource Style_Warning}" Margin="0,2,0,0"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <!-- The scope, inline and primary: all N using it, or only the M selected. Pinned once this row is edited. -->
                                                                <TextBlock Text="Changes" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                                                <StackPanel>
                                                                    <RadioButton Content="{Binding ScopeAllLabel}" IsChecked="{Binding ScopeAll, Mode=TwoWay}"/>
                                                                    <RadioButton Content="{Binding ScopeSelectedLabel}" IsChecked="{Binding ScopeSelected, Mode=TwoWay}" IsEnabled="{Binding ScopeSelectedEnabled}" ToolTip="{Binding ScopeReason}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                                                                <ToggleButton x:Name="toggleButton_More" Content="⋯ More" HorizontalAlignment="Left" Style="{StaticResource Style_LinkToggle}" Margin="0,6,0,0" ToolTip="Keep name, the layer to adjust, the thickness range and the heat flow."
                                                                    AutomationProperties.AutomationId="toggleButton_More"/>
                                                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding IsChecked, ElementName=toggleButton_More, Converter={StaticResource BoolToVisibility}}">
                                                                        <CheckBox Content="Keep name" IsChecked="{Binding KeepName, Mode=TwoWay}" IsEnabled="{Binding KeepNameEnabled}" ToolTip="Change the construction itself instead of creating a new one."/>
                                                                        <TextBlock Text="{Binding KeepNameReason}" Style="{StaticResource PartO.Caption}"/>
                                                                        <TextBlock Text="Layer to adjust" Margin="0,6,0,2"/>
                                                                        <ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"/>
                                                                        <TextBlock Text="Thickness range [mm]" Margin="0,6,0,2"/>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBox Width="60" Text="{Binding MinThicknessText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum thickness of the adjusted layer."/>
                                                                            <TextBlock Text="to" Margin="6,0" VerticalAlignment="Center"/>
                                                                            <TextBox Width="60" Text="{Binding MaxThicknessText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum thickness of the adjusted layer."/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="Heat flow" Margin="0,6,0,2"/>
                                                                        <ComboBox ItemsSource="{Binding HeatFlowOptions}" SelectedItem="{Binding SelectedHeatFlow, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- GLAZING: Change... opens the list of complete systems under the row -->
                                                        <StackPanel Style="{StaticResource Style_ApertureOnly}" Margin="0,6,0,0">
                                                            <Button Content="Change…" HorizontalAlignment="Left" Padding="10,1" Click="button_Change_Click" AutomationProperties.AutomationId="button_Change"
                                                                    AutomationProperties.Name="{Binding Row.ConstructionName, StringFormat=Change {0}}" ToolTip="Choose another complete glazing system.">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ChangeOpen}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <StackPanel Visibility="{Binding ChangeOpen, Converter={StaticResource BoolToVisibility}}">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Style_Link}" Click="button_CloseChange_Click" ToolTip="Close the list and drop the choice."/>
                                                                    <Button DockPanel.Dock="Right" Content="Create new…" Style="{StaticResource Style_Link}" Click="button_CreateNew_Click" AutomationProperties.AutomationId="button_CreateNew"
                                                                            AutomationProperties.Name="Create a new glazing system" Visibility="{Binding CanCreateNew, Converter={StaticResource BoolToVisibility}}"
                                                                            ToolTip="Build a new glazing system from panes and gas gaps, starting from the chosen system. It is saved in My glazing systems; the model is not changed."/>
                                                                    <TextBlock Text="Choose a complete system" FontWeight="SemiBold"/>
                                                                </DockPanel>
                                                                <DockPanel Margin="0,4,0,0">
                                                                    <ToggleButton x:Name="toggleButton_GlazingFilters" DockPanel.Dock="Right" Content="⋯ Filters" Style="{StaticResource Style_LinkToggle}" VerticalAlignment="Center"
                                                                                  AutomationProperties.AutomationId="toggleButton_GlazingFilters" ToolTip="Filter the systems by g-value and light transmittance, choose the order, and which sources are listed."/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Target Uw ≤" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBox Width="60" Text="{Binding GlazingTargetText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="textBox_GlazingTarget"
                                                                                 AutomationProperties.Name="Target Uw" ToolTip="Show only the systems with this overall U-value or better."/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <!-- FILTERS (Stage F): the g / light filters, the order and the source toggles of the shared glazing view-model. -->
                                                                <Grid Margin="0,4,0,0" Visibility="{Binding IsChecked, ElementName=toggleButton_GlazingFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="grid_GlazingFilters">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="g from" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBox Width="48" Text="{Binding GlazingMinGText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="textBox_GlazingMinG" AutomationProperties.Name="g from"
                                                                                 ToolTip="The smallest total solar energy transmittance (0-1)."/>
                                                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0"/>
                                                                        <TextBox Width="48" Text="{Binding GlazingMaxGText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="textBox_GlazingMaxG" AutomationProperties.Name="g to"
                                                                                 ToolTip="The largest total solar energy transmittance (0-1)."/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Light at least" VerticalAlignment="Center" Margin="0,4,6,0"/>
                                                                    <TextBox Grid.Row="1" Grid.Column="1" Width="48" HorizontalAlignment="Left" Margin="0,4,0,0" Text="{Binding GlazingMinLightText, UpdateSourceTrigger=PropertyChanged}"
                                                                             AutomationProperties.AutomationId="textBox_GlazingMinLight" AutomationProperties.Name="Light at least" ToolTip="The smallest light transmittance (0-1)."/>
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sort by" VerticalAlignment="Center" Margin="0,4,6,0"/>
                                                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" HorizontalAlignment="Left" MinWidth="150" ItemsSource="{Binding GlazingSortOptions}" SelectedItem="{Binding GlazingSelectedSort, Mode=TwoWay}"
                                                                              AutomationProperties.AutomationId="comboBox_GlazingSort" AutomationProperties.Name="Sort by" ToolTip="The order of the list. The automatic choice against a target is always the best Uw that meets it."/>
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Show" VerticalAlignment="Top" Margin="0,5,6,0"/>
                                                                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                                                                        <CheckBox Content="Default library" IsChecked="{Binding GlazingIncludeLibrary, Mode=TwoWay}" Margin="0,0,10,0" AutomationProperties.AutomationId="checkBox_GlazingIncludeLibrary"
                                                                                  ToolTip="List the systems of the SAM default library."/>
                                                                        <CheckBox Content="Added sources" IsChecked="{Binding GlazingIncludeAdded, Mode=TwoWay}" AutomationProperties.AutomationId="checkBox_GlazingIncludeAdded"
                                                                                  ToolTip="List the systems of the sources added with Add source…. The model's systems and My glazing systems are always listed."/>
                                                                    </WrapPanel>
                                                                </Grid>
                                                                <TextBlock Text="{Binding CandidateCountText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0" AutomationProperties.AutomationId="textBlock_CandidateCount"/>
                                                                <TextBlock Text="{Binding GlazingFiltersText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"
                                                                           Visibility="{Binding HasGlazingFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="textBlock_GlazingFilters"/>
                                                                <Border Height="2"/>
                                                                <TextBlock Text="{Binding GlazingNotesText}" Style="{StaticResource Style_Warning}" TextWrapping="Wrap" MaxWidth="260" Margin="0,0,0,2"
                                                                           Visibility="{Binding HasGlazingNotes, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="textBlock_GlazingNotes"/>
                                                                <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" MaxHeight="230" HorizontalContentAlignment="Stretch"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="listBox_Candidates">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel ToolTip="{Binding Tooltip}" Margin="0,2" PreviewMouseRightButtonDown="candidate_PreviewMouseRightButtonDown">
                                                                                <StackPanel.ContextMenu>
                                                                                    <ContextMenu>
                                                                                        <MenuItem Header="New system based on this…" Click="menuItem_NewBasedOn_Click" AutomationProperties.AutomationId="menuItem_NewBasedOn"
                                                                                                  ToolTip="Open the Glazing System Builder starting from this system. Saving there adds a new system to My glazing systems; nothing else changes."/>
                                                                                        <MenuItem Header="Open in Builder…" Click="menuItem_OpenInBuilder_Click" AutomationProperties.AutomationId="menuItem_OpenInBuilder"
                                                                                                  Visibility="{Binding IsUserSystem, Converter={StaticResource BoolToVisibility}}"
                                                                                                  ToolTip="Edit this system in the Glazing System Builder: save the result as a new system, or save and replace this one (it is moved to the archive)."/>
                                                                                        <MenuItem Header="Rename…" Click="menuItem_RenameUser_Click" AutomationProperties.AutomationId="menuItem_RenameUser"
                                                                                                  Visibility="{Binding IsUserSystem, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        <MenuItem Header="Remove…" Click="menuItem_RemoveUser_Click" AutomationProperties.AutomationId="menuItem_RemoveUser"
                                                                                                  Visibility="{Binding IsUserSystem, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    </ContextMenu>
                                                                                </StackPanel.ContextMenu>
                                                                                <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="Uw "/><Run Text="{Binding UwText, Mode=OneWay}"/><Run Text=" · Ug "/><Run Text="{Binding UgText, Mode=OneWay}"/><Run Text=" · Uf "/><Run Text="{Binding UfText, Mode=OneWay}"/><Run Text=" · g "/><Run Text="{Binding GText, Mode=OneWay}"/><Run Text=" · LT "/><Run Text="{Binding LightTransmittanceText, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock Style="{StaticResource PartO.Caption}" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding SourceLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding WarningText}" Style="{StaticResource Style_Warning}" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding PreviewGlyph}" Style="{StaticResource PartO.StatusGlyph}"/>
                                                                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" MaxWidth="260" AutomationProperties.AutomationId="textBlock_Preview"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding GlazingComparisonText}" Style="{StaticResource PartO.Caption}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                           AutomationProperties.AutomationId="textBlock_GlazingComparison"/>
                                                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding BlockReason}" Style="{StaticResource Style_Danger}" Margin="0,2,0,0"/>
                                                                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" Style="{StaticResource Style_Warning}" Margin="0,2,0,0"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="Changes" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                                                <StackPanel>
                                                                    <RadioButton Content="{Binding ScopeAllLabel}" IsChecked="{Binding ScopeAll, Mode=TwoWay}"/>
                                                                    <RadioButton Content="{Binding ScopeSelectedLabel}" IsChecked="{Binding ScopeSelected, Mode=TwoWay}" IsEnabled="{Binding ScopeSelectedEnabled}" ToolTip="{Binding ScopeReason}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource PartO.Caption}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
