<UserControl x:Class="SAM.Analytical.UI.WPF.ThermalPerformanceSpikeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180" FontFamily="Roboto Light">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- B0 DOCKING SPIKE, read-only: a side panel that follows the selection and shows its type, construction and count.
         No editing, no Tas, no model writes. -->
    <Border Background="White" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1,0,0,0" Padding="10,8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Thermal performance" Style="{StaticResource PartO.SectionHeading}" FontSize="14"/>
            <TextBlock x:Name="textBlock_Summary" DockPanel.Dock="Top" Style="{StaticResource PartO.Caption}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsControl_Rows" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="8,6" Background="{StaticResource PartO.Brush.Surface}" BorderBrush="{StaticResource PartO.Brush.Border}" BorderThickness="1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PartO.Caption}"/>
                                    <TextBlock Text="{Binding ConstructionName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PartO.Brush.Text}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource PartO.Brush.Text}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
