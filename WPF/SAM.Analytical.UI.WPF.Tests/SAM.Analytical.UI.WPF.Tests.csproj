<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <!-- PartOOptimisationTests builds a PartOSimulationContext, whose WeatherData property makes this type
         part of the signature the compiler has to resolve. A plain data carrier - no TAS COM type is
         reached, so the suite still runs on a machine with no TAS installed. -->
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
    <!-- The Part O tests read and write SAM.Analytical.Tas.SpaceParameter.ZoneGuid, the identity the TAS
         round trip preserves. Declared here because a HintPath Reference on the referenced project does not
         flow to this one for compilation - the three above are re-declared for exactly that reason. Nothing
         in these tests touches a TBD/TSD/TAS3D COM type, so the interop assemblies are never loaded: the
         same property SAM.Analytical.Tas.TM59's PartODiagnosticLog relies on to stay testable without an
         installed TAS. -->
    <Reference Include="SAM.Analytical.Tas">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.dll</HintPath>
    </Reference>
    <!-- SimulationZoneIdentityTests exports the DomOv XML through Tas.TM59.Convert.ToXml - the one consumer
         that actually depends on Modify.RestampSimulationZoneIdentity - and asserts which identity comes out
         of it. Convert.ToTM59 / Convert.ToXml / Building / Zone are XML writers over analytical objects, so
         this stays as COM-free as the reference above. -->
    <!-- The Approved Document O Iteration 3 tests drive the real orchestration over REAL SAM_Systems and
         SAM_Tas result types - a materialisation, a ventilation route, a thermal source, a set of
         resultant temperatures - rather than over stand-ins for them. A hand-written stand-in would let
         PR4 be tested against PR4's idea of PR1/PR2/PR3, which is exactly the disagreement the
         reconciliation exists to catch. Every one of those types is free of TAS COM types and publicly
         constructible, so nothing here needs an installed TAS. -->
    <Reference Include="SAM.Analytical.Systems">
      <HintPath>..\..\..\SAM_Systems\build\SAM.Analytical.Systems.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Systems">
      <HintPath>..\..\..\SAM_Systems\build\SAM.Core.Systems.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas.TPD">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.TPD.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Tas">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Core.Tas.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas.TM59">
      <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.TM59.dll</HintPath>
    </Reference>
    <!-- SpaceAssumptionsPdfTests / SpaceDesignLoadSummaryPdfTests: the reporting options (UnitStyle), the renderer
         contract and the renderer's font resolver, and the SAM entry point the command must match. PDFsharp itself
         arrives through SAM.Analytical.UI.WPF's package reference. -->
    <Reference Include="SAM.Analytical.Reporting">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.Reporting.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Reporting">
      <HintPath>..\..\..\SAM\build\SAM.Core.Reporting.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Reporting.Pdf">
      <HintPath>..\..\..\SAM\build\SAM.Core.Reporting.Pdf.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Units">
      <HintPath>..\..\..\SAM\build\SAM.Units.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.StaFact" Version="1.2.69" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAM.Analytical.UI.WPF\SAM.Analytical.UI.WPF.csproj" />
  </ItemGroup>
</Project>
