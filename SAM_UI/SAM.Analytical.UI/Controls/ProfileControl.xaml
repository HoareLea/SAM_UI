<UserControl x:Class="SAM.Analytical.UI.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:core="clr-namespace:SAM.Core.UI.WPF;assembly=SAM.Core.UI.WPF"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="820">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Identity -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboBox_Category" Grid.Row="1" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" Margin="0,2"/>

            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Min" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_MinValue" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBlock Grid.Column="2" Text="Max" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_MaxValue" Grid.Column="3" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>
            </Grid>
        </Grid>

        <!-- Values grid | chart -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DataGrid_Values" Grid.Column="0" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All"
                      CellEditEnding="DataGrid_Values_CellEditEnding"
                      core:DataGridBehavior.SelectAllOnEdit="True">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Column_Index" Header="Index" Binding="{Binding Index}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn x:Name="Column_Value" Header="Value" Binding="{Binding Value}" Width="*"/>
                    <DataGridTextColumn x:Name="Column_ProfileName" Header="Profile" Binding="{Binding ProfileName}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <oxy:PlotView x:Name="Chart_Main" Grid.Column="2"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="Button_Remove" Content="Remove" Width="90" Height="28" Margin="0,0,6,0" Click="Button_Remove_Click"/>
            <Button x:Name="Button_SetProfile" Content="Set Profile" Width="90" Height="28" Margin="0,0,6,0" Click="Button_SetProfile_Click"/>
            <Button x:Name="Button_SetValue" Content="Set Value" Width="90" Height="28" Click="Button_SetValue_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
